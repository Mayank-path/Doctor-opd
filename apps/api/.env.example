# Database connection configuration template for apps/api
# Replace USER, PASSWORD, HOST, PORT, and DATABASE with valid credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/doctor_opd_dev?schema=public"

# JWT Authentication Configuration
JWT_SECRET="replace-with-at-least-32-character-random-secret"
