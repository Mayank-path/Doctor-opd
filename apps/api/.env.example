# Server Environment & Port Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection URL (Prisma)
# Replace USER, PASSWORD, HOST, PORT, and DATABASE with your database credentials.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/doctor_opd_dev?schema=public"

# JWT Authentication Configuration (HS256)
# JWT_SECRET must be at least 32 characters long.
JWT_SECRET="replace-with-at-least-32-character-random-secret"
JWT_ISSUER="doctor-opd-api"
JWT_AUDIENCE="doctor-opd-client"
JWT_EXPIRES_IN="1h"

# Optional Initial Admin Bootstrap Configuration (npm run bootstrap:admin)
# For non-interactive bootstrap execution:
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="replace-with-secure-password"
# BOOTSTRAP_ADMIN_NAME="Clinic Administrator"
# BOOTSTRAP_ADMIN_PHONE="+919999900001"
# BOOTSTRAP_CLINIC_NAME="City Health Clinic"
# BOOTSTRAP_CONFIRM_DATABASE_NAME="doctor_opd_dev"

